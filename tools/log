#!/usr/bin/env bash

# Source configuration
PRJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
source "${PRJ_DIR}/config.sh"

# Show local development logs
LOG_FILE="${PRJ_DIR}/${DEV_LOG_FILE}"

if [ ! -f "$LOG_FILE" ]; then
    log_error "Log file not found at: $LOG_FILE"
    exit 1
fi

log_info "Showing development logs..."
tail -n 100 -f "$LOG_FILE"

exit 0
