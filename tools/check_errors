#!/usr/bin/env bash

# Script directory path
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PROJECT_ROOT="$SCRIPT_DIR/.."
LOG_FILE="${PROJECT_ROOT}/output.log"

# Check if log file exists
if [ ! -f "$LOG_FILE" ]; then
    echo "No log file found at: $LOG_FILE"
    exit 1
fi

echo "Checking for errors in: $LOG_FILE"
echo "=========================================="
echo ""

# Search for errors and exceptions
if grep -q "Traceback\|Exception\|Error" "$LOG_FILE"; then
    cat -n "$LOG_FILE" | grep -e "Traceback" -A 15 -B 5
else
    echo "No errors found in log file."
fi

exit 0
