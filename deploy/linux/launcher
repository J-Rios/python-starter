#!/usr/bin/env bash

# Launcher script for python-starter application
# This script is called by the systemd service

APP_DIR="/opt/python-starter"
VENV_DIR="${APP_DIR}/.venv"
LOG_FILE="/var/log/python-starter/python-starter.log"

# Ensure creation of log directory
mkdir -p "$(dirname "$LOG_FILE")"

# Activate virtual environment
if [ ! -f "${VENV_DIR}/bin/activate" ]; then
    echo "Error: Virtual environment not found at ${VENV_DIR}" >> "$LOG_FILE"
    exit 1
fi
source "${VENV_DIR}/bin/activate"

# Run the application
cd "${APP_DIR}" || exit 1
python3 src/app.py >> "$LOG_FILE" 2>&1

# Deactivate virtual environment
deactivate

exit 0
