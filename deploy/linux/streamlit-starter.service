[Unit]
Description=Python Streamlit Application Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/streamlit-starter
ExecStart=/opt/streamlit-starter/launcher
Restart=always
RestartSec=10
StandardOutput=append:/var/log/streamlit-starter/streamlit-starter.log
StandardError=append:/var/log/streamlit-starter/streamlit-starter.log
Environment=PYTHONUNBUFFERED=1
Environment=STREAMLIT_SERVER_HEADLESS=true

[Install]
WantedBy=multi-user.target
